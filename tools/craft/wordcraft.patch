+/// WindowsFX: a Cyrillic word in a run marked English (the default) is checked as Russian, the
+/// way Word detects the language of what is typed.
+fn fx_route(word: &str, lang: ProofLang) -> ProofLang {
+    if lang == ProofLang::En && word.chars().find(|c| c.is_alphabetic()).is_some_and(ru::is_cyrillic) {
+        ProofLang::Ru
+    } else {
+        lang
+    }
+}
+
 /// Spelling suggestions for a word misspelled in `lang` (best first, at most `max`).
 pub fn suggest_in(word: &str, max: usize, lang: ProofLang) -> Vec<String> {
+    let lang = fx_route(word, lang);
     match lang {
         ProofLang::En => suggest(word, max),
         ProofLang::Pl => pl::suggest(word, max),
@@ -743,6 +756,12 @@ pub fn check_text_with(text: &str, spans: &[(Range<usize>, ProofLang)], opts: &O
             *l = ProofLang::Other;
         }
         ProofLang::Other
+    } else if fx_looks_russian(text) {
+        // WindowsFX: a paragraph typed in Russian under the default English language is Russian.
+        for (_, l) in merged.iter_mut().filter(|(_, l)| *l == ProofLang::En) {
+            *l = ProofLang::Ru;
+        }
+        ProofLang::Ru
     } else {
         ProofLang::En
     };
@@ -776,6 +795,18 @@ pub fn check_text_with(text: &str, spans: &[(Range<usize>, ProofLang)], opts: &O
     v
 }
 
+/// WindowsFX: are most letters of `text` Cyrillic?
+fn fx_looks_russian(text: &str) -> bool {
+    let (mut cyr, mut all) = (0usize, 0usize);
+    for c in text.chars().filter(|c| c.is_alphabetic()) {
+        all += 1;
+        if ru::is_cyrillic(c) {
+            cyr += 1;
+        }
+    }
+    all > 0 && cyr * 2 > all
+}
+
 /// Grammar issues in a paragraph of English text.
 pub fn check_grammar(text: &str) -> Vec<Issue> {
     grammar_en(text, true)
@@ -1469,3 +1500,19 @@ mod tests {
         }
     }
 }
+
+#[cfg(test)]
+mod fx_tests {
+    use super::*;
+    #[test]
+    fn russian_under_default_english_is_checked() {
+        let t = "Привет, как дила у тебя?";
+        let v = check_text(t, &[]);
+        let bad: Vec<&str> = v.iter().filter(|i| i.kind == IssueKind::Spelling).map(|i| &t[i.start..i.end]).collect();
+        assert_eq!(bad, vec!["дила"], "{v:?}");
+        assert!(!suggest_in("дила", 5, ProofLang::En).is_empty());
+        let t = "Hello мир and превет";
+        let bad: Vec<String> = check_text(t, &[]).iter().map(|i| t[i.start..i.end].to_string()).collect();
+        assert_eq!(bad, vec!["превет".to_string()]);
+    }
+}
